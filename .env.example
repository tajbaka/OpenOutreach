# OpenOutreach environment example
# Copy to `.env` and fill in the values you actually use.

# credentials
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
BACKFILL_LINKEDIN_USERNAME=
BACKFILL_LINKEDIN_PASSWORD=
SALES_NAV_LINKEDIN_USERNAME=
SALES_NAV_LINKEDIN_PASSWORD=

# llm
LLM_API_KEY=
AI_MODEL=
LLM_API_BASE=

# database
DATABASE_URL=

# slack
SLACK_WEBHOOK_URL=
SLACK_REPLIES_WEBHOOK_URL=
SLACK_HIGH_SIGNAL_URL=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
MANUAL_REPLY_POLL_SECONDS=60

# marketplace_listener
FEDRAMP_MARKETPLACE_CHANGELOG_URL=https://raw.githubusercontent.com/FedRAMP/marketplace-fedramp-gov-data/main/fedramp-status-changelog.json
FEDRAMP_MARKETPLACE_DATA_URL=https://raw.githubusercontent.com/FedRAMP/marketplace-fedramp-gov-data/main/data.json
FEDRAMP_MARKETPLACE_FETCH_TIMEOUT_SECONDS=45

# sheets
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_TAB_NAME=People

# company
OUR_COMPANY_NAME=
OUR_WEBSITE_URL=

# enrichment
BETTERCONTACT_API_KEY=
LEADMAGIC_API_KEY=
PROSPEO_API_KEY=

# feature_flags
ENABLE_CONNECT=true
ENABLE_SWEEP_CONNECTIONS=true
ENABLE_INCREMENTAL_CONNECTION_SWEEP=true
ENABLE_FOLLOW_UP=true
ENABLE_GMAIL_SEQUENCE=false
ENABLE_AUTO_DISCOVERY=true
ENABLE_PROFILE_DISCOVERY=false
ENABLE_REALTIME_LISTENER=false
ENABLE_LINKEDIN_FEED_COLLECTOR=false
ENABLE_NODE_MONITOR=true
ENABLE_ACTIVE_HOURS=true
ENABLE_FREEMIUM_CAMPAIGN=false
ENABLE_AUTO_PHONE_ENRICHMENT=false

# limits
MAX_TOTAL_DAILY_ACTIONS=200
CONNECT_DAILY_LIMIT=
CONNECT_WEEKLY_LIMIT=
FOLLOW_UP_DAILY_LIMIT=
CONNECT_LOW_POOL_THRESHOLD=100
CONNECTION_SWEEP_INTERVAL_HOURS=2
CONNECTION_SWEEP_OVERLAP_HOURS=24
CONNECTION_SWEEP_INITIAL_LOOKBACK_DAYS=7
CONNECTION_SWEEP_MAX_SECONDS=180
CONNECTION_SWEEP_MAX_ROUNDS=120
CONNECTION_SWEEP_INCOMPLETE_RETRY_MINUTES=10
CONNECTION_SWEEP_MAX_QUEUE_DELAY_MINUTES=30
TASK_RUNNING_STALE_MINUTES=30

# schedule
ACTIVE_START_HOUR=9
ACTIVE_END_HOUR=17
ACTIVE_TIMEZONE=America/Toronto
REST_DAYS=5,6

# discovery
DISCOVERY_DAILY_LIMIT=25
DISCOVERY_MAX_CARDS_PER_RUN=200
DISCOVERY_MAX_PAGES_PER_RUN=10
DISCOVERY_MAX_PROFILE_VISITS_PER_RUN=40
DISCOVERY_MAX_CONSECUTIVE_NO_MATCHES=75
DISCOVERY_MAX_RUN_MINUTES=120
DISCOVERY_PROFILE_DELAY_MIN_SECONDS=20
DISCOVERY_PROFILE_DELAY_MAX_SECONDS=45

# realtime
LISTENER_CDP_PORT=9222
LISTENER_CATCHUP_GAP_MINUTES=30
LISTENER_PUMP_SLICE_SECONDS=30
LISTENER_ACTIVE_START_HOUR=0
LISTENER_ACTIVE_END_HOUR=24
LISTENER_REST_DAYS=

# feed_collection
LINKEDIN_FEED_COLLECTION_HOUR=17
LINKEDIN_FEED_COLLECTION_MINUTE=0
LINKEDIN_FEED_COLLECTION_TIMEZONE=America/Toronto
LINKEDIN_FEED_COLLECTION_RETRY_MINUTES=60
LINKEDIN_FEED_COLLECTION_CUTOFF_OVERLAP_MINUTES=1
LINKEDIN_FEED_COLLECTION_CATCHUP_DAYS=14
LINKEDIN_FEED_COLLECTION_MAX_POSTS=1000
LINKEDIN_FEED_COLLECTION_STOP_AFTER_SEEN=15
LINKEDIN_FEED_COLLECTION_STOP_AFTER_STALE=25
LINKEDIN_FEED_COLLECTION_SCROLL_PAUSE_SECONDS=2
LINKEDIN_FEED_COLLECTION_ACTION_DELAY_MIN_SECONDS=0.7
LINKEDIN_FEED_COLLECTION_ACTION_DELAY_MAX_SECONDS=1.8

# enrichment_tuning
ENRICHMENT_MAX_DURATION_SECONDS=600
ENRICHMENT_HTTP_TIMEOUT_SECONDS=5
ENRICHMENT_WAIT_POLL_SECONDS=30
BETTERCONTACT_POLL_INTERVAL_SECONDS=15

# monitoring
MONITOR_INTERVAL_SECONDS=300
PEER_STALE_MINUTES=15
DEGRADED_REALERT_HOURS=6
TASK_FAILURE_STREAK_THRESHOLD=5
EXPECTED_OUTBOUND_SENDERS=
SENDER_ACTIVITY_GRACE_MINUTES=60
SENDER_ACTIVITY_STALE_MINUTES=90
